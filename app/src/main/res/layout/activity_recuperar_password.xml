<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true"
    tools:context=".ui.RecuperarPassword">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/btnBackRecover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="←"
            android:textColor="@color/text_white"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvRecoverTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="RECUPERAR ACCESO"
            android:textColor="@color/text_white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBackRecover" />

        <TextView
            android:id="@+id/tvRecoverSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ingresa tu correo para recibir un código de seguridad."
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRecoverTitle" />

        <!-- 1. CAMPO CORREO -->
        <TextView
            android:id="@+id/tvLabelRecoverEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Correo electrónico"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRecoverSubtitle" />

        <EditText
            android:id="@+id/etRecoverEmail"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input"
            android:hint="ejemplo@nexura.gg"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLabelRecoverEmail" />

        <!-- CONTENEDOR FASE 2: CÓDIGO Y NUEVA CONTRASEÑA (INICIALMENTE OCULTO) -->
        <LinearLayout
            android:id="@+id/layoutStep2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etRecoverEmail">

            <!-- CÓDIGO DE 6 DÍGITOS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Código de Verificación (6 dígitos)"
                android:textColor="@color/neon_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSecurityCode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input"
                android:gravity="center"
                android:hint="123456"
                android:inputType="number"
                android:letterSpacing="0.2"
                android:maxLength="6"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_hint"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- NUEVA CONTRASEÑA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Nueva Contraseña"
                android:textColor="@color/text_gray"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input"
                android:hint="Mínimo 6 caracteres"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- BOTÓN DE ACCIÓN (CAMBIA SEGÚN LA FASE) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnActionRecovery"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/boton_gradiante"
            android:text="Enviar Código"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutStep2" />

        <!-- CANCELAR Y VOLVER -->
        <TextView
            android:id="@+id/tvCancelRecover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:text="Cancelar y Volver al Login"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnActionRecovery" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>