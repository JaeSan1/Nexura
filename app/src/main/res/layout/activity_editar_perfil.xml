<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14">

    <!-- CONTENIDO PRINCIPAL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- HEADER Y BANNER -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="50dp">

                <!-- Banner Editable -->
                <ImageView
                    android:id="@+id/ivBannerEdit"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_logo_nexura"
                    android:contentDescription="Banner de perfil" />

                <!-- Capa oscura para contraste -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:background="#40000000" />

                <!-- Botón Volver -->
                <TextView
                    android:id="@+id/btnBackEditProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:background="#990B0E14"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="← Volver"
                    android:textColor="#00FFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Avatar Editable (Contenedor con ID requerido) -->
                <FrameLayout
                    android:id="@+id/containerBannerEdit"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardBackgroundColor="#0B0E14"
                        app:cardCornerRadius="52dp"
                        app:cardElevation="6dp">

                        <ImageView
                            android:id="@+id/ivAvatarEdit"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="4dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/avatar"
                            android:contentDescription="Avatar de perfil" />
                    </androidx.cardview.widget.CardView>
                </FrameLayout>
            </RelativeLayout>

            <!-- FORMULARIO DE EDICIÓN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">

                <!-- Gamertag -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Gamertag"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etGamertagEdit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="16dp"
                    android:background="#161B26"
                    android:hint="Tu gamertag"
                    android:inputType="text"
                    android:paddingHorizontal="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#4B5563"
                    android:textSize="15sp" />

                <!-- Ciudad -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Ciudad"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etCityEdit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="16dp"
                    android:background="#161B26"
                    android:hint="Ej: Chillán"
                    android:inputType="text"
                    android:paddingHorizontal="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#4B5563"
                    android:textSize="15sp" />

                <!-- Biografía -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Biografía"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etBioEdit"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginBottom="24dp"
                    android:background="#161B26"
                    android:gravity="top|start"
                    android:hint="Escribe algo sobre ti..."
                    android:inputType="textMultiLine"
                    android:padding="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#4B5563"
                    android:textSize="15sp" />

                <!-- Botón Guardar Cambios -->
                <Button
                    android:id="@+id/btnSaveProfile"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:backgroundTint="#00FFFF"
                    android:text="Guardar Cambios"
                    android:textColor="#0B0E14"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- CAPA DE CARGA (LOADING OVERLAY) -->
    <FrameLayout
        android:id="@+id/layoutLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0B0E14"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="#00FFFF" />

            <TextView
                android:id="@+id/tvLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Guardando cambios..."
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>