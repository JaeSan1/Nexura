<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true"
    tools:context=".ui.EditarPerfil">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- HEADER -->
        <TextView
            android:id="@+id/btnBackEditProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvEditProfileTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:letterSpacing="0.1"
            android:text="EDITAR PERFIL"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btnBackEditProfile"
            app:layout_constraintStart_toEndOf="@id/btnBackEditProfile"
            app:layout_constraintTop_toTopOf="@id/btnBackEditProfile" />

        <!-- SELECTOR DE AVATAR -->
        <FrameLayout
            android:id="@+id/frameEditAvatar"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/avatar"
            android:padding="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEditProfileTitle">

            <ImageView
                android:id="@+id/ivEditAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/electric_purple"
                android:scaleType="centerCrop" />

            <TextView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/categoria"
                android:gravity="center"
                android:text="📷"
                android:textSize="14sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/btnChangePhotoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cambiar foto de perfil"
            android:textColor="@color/neon_cyan"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/frameEditAvatar" />

        <!-- CAMPO: GAMERTAG -->
        <TextView
            android:id="@+id/lblEditUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Nombre de usuario (Gamertag)"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnChangePhotoText" />

        <EditText
            android:id="@+id/etEditUsername"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/input"
            android:hint="thegoat"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblEditUsername" />

        <!-- CAMPO: CIUDAD -->
        <TextView
            android:id="@+id/lblEditCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ciudad / Región principal"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etEditUsername" />

        <EditText
            android:id="@+id/etEditCity"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/input"
            android:hint="Chillán, Región de Ñuble"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblEditCity" />

        <!-- CAMPO: BIOGRAFÍA -->
        <TextView
            android:id="@+id/lblEditBio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Biografía / Presentación"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etEditCity" />

        <EditText
            android:id="@+id/etEditBio"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/input"
            android:gravity="top"
            android:hint="Escribe algo sobre ti, eventos favoritos..."
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_hint"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblEditBio" />

        <!-- BOTÓN GUARDAR -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveProfile"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/boton_gradiante"
            android:text="Guardar Cambios"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etEditBio" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>