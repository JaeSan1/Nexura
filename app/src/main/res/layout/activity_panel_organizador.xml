<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/btnBackPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Volver"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingEnd="16dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Panel Organizador"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Botón Crear Evento Nuevo -->
    <Button
        android:id="@+id/btnCreateNewEventPanel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#00FFFF"
        android:text="+ Crear Nuevo Evento"
        android:textColor="#0B0E14"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Subtítulo de Lista -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mis Eventos Publicados"
        android:textColor="#9CA3AF"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMisEventosOrganizados"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <!-- Estado Vacío -->
        <TextView
            android:id="@+id/tvEmptyStateOrganizador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Aún no has creado ningún evento.\n¡Haz clic en el botón de arriba para comenzar!"
            android:textAlignment="center"
            android:textColor="#6B7280"
            android:textSize="15sp"
            android:visibility="gone" />

    </FrameLayout>
</LinearLayout>