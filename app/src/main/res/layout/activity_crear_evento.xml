<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header / Barra Superior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBackCreate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:text="← Volver"
                android:textColor="#00FFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Crear Nuevo Evento"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="48dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <!-- Banner / Portada del Evento -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#161B26"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivEventPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Portada del evento"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_logo_nexura" />

                <!-- Overlay inferior con aviso -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="#B30B0E14"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📷 Toca para seleccionar imagen de portada"
                        android:textColor="#00FFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- SECCIÓN 1: Información General -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#161B26"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="INFORMACIÓN PRINCIPAL"
                    android:textColor="#00FFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Título -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Título del evento"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etEventTitle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="14dp"
                    android:background="#222B3D"
                    android:hint="Ej: Torneo Gamer Chillán 2026"
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#4B5563"
                    android:textSize="14sp" />

                <!-- Categoría -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Categoría"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etEventCategory"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="14dp"
                    android:background="#222B3D"
                    android:hint="Gaming, Anime, Deporte, Tecnología..."
                    android:inputType="text"
                    android:paddingHorizontal="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#4B5563"
                    android:textSize="14sp" />

                <!-- Descripción -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Descripción detallada"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etEventDescription"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:background="#222B3D"
                    android:gravity="top|start"
                    android:hint="Explica de qué trata el evento, cronograma, requisitos o reglas..."
                    android:inputType="textMultiLine"
                    android:padding="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#4B5563"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SECCIÓN 2: Fecha y Lugar -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#161B26"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="FECHA Y UBICACIÓN"
                    android:textColor="#00FFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Fecha -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Fecha y hora"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etEventDate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="14dp"
                    android:background="#222B3D"
                    android:hint="Ej: Sáb 15 Nov - 18:00 hrs"
                    android:inputType="text"
                    android:paddingHorizontal="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#4B5563"
                    android:textSize="14sp" />

                <!-- Ciudad -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Ciudad"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etEventCity"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="14dp"
                    android:background="#222B3D"
                    android:hint="Ej: Chillán"
                    android:inputType="text"
                    android:paddingHorizontal="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#4B5563"
                    android:textSize="14sp" />

                <!-- Botón Selector de Mapa -->
                <Button
                    android:id="@+id/btnSeleccionarMapa"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="14dp"
                    android:backgroundTint="#1E293B"
                    android:text="📍 Seleccionar ubicación en el mapa"
                    android:textAllCaps="false"
                    android:textColor="#00FFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Dirección / Recinto -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Dirección o Recinto"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etEventLocation"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#222B3D"
                    android:hint="Se completa con el mapa o escríbelo manualmente"
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#4B5563"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SECCIÓN 3: Recompensas y Coordenadas GPS -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#161B26"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="GAMIFICACIÓN Y GPS"
                    android:textColor="#00FFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Recompensa XP -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Recompensa de XP por asistencia"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etEventXp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="14dp"
                    android:background="#222B3D"
                    android:hint="100"
                    android:inputType="number"
                    android:paddingHorizontal="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#4B5563"
                    android:textSize="14sp" />

                <!-- Coordenadas Lat/Lng (completadas por el mapa) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="Latitud GPS"
                            android:textColor="#9CA3AF"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/etEventLat"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="#222B3D"
                            android:focusable="false"
                            android:hint="-36.6066"
                            android:inputType="none"
                            android:paddingHorizontal="14dp"
                            android:textColor="#94A3B8"
                            android:textColorHint="#4B5563"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="Longitud GPS"
                            android:textColor="#9CA3AF"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/etEventLng"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="#222B3D"
                            android:focusable="false"
                            android:hint="-72.1033"
                            android:inputType="none"
                            android:paddingHorizontal="14dp"
                            android:textColor="#94A3B8"
                            android:textColorHint="#4B5563"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botón Publicar -->
        <Button
            android:id="@+id/btnSaveEvent"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#00FFFF"
            android:text="Publicar Evento"
            android:textColor="#0B0E14"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>