<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14">

    <!-- Vista de Mapa OpenStreetMap -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Contenedor Superior Flotante (Header + Buscador en modo selección) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_margin="14dp"
        android:background="#E60B0E14"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Barra de Navegación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBackMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="← Volver"
                android:textColor="#00FFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMapHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Mapa de Eventos"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMiGpsMap"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:backgroundTint="#00FFFF"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="Mi GPS"
                android:textAllCaps="false"
                android:textColor="#0B0E14"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Barra de Búsqueda (Visible solo al seleccionar ubicación) -->
        <LinearLayout
            android:id="@+id/layoutBuscadorMapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/etBuscarDireccionMap"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="#222B3D"
                android:hint="Buscar calle, plaza o recinto..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="13.5sp" />

            <Button
                android:id="@+id/btnBuscarDireccionMap"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:backgroundTint="#00FFFF"
                android:text="Buscar"
                android:textAllCaps="false"
                android:textColor="#0B0E14"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Lista Desplegable de Resultados -->
        <ScrollView
            android:id="@+id/scrollSugerenciasMapa"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:background="#1E293B"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/listaSugerenciasMapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- Panel Inferior de Confirmación (Visible solo al seleccionar ubicación) -->
    <LinearLayout
        android:id="@+id/layoutConfirmarMapa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="14dp"
        android:background="#F2161B26"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UBICACIÓN SELECCIONADA (TOCA O ARRASTRA EL PIN)"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDireccionSeleccionadaMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="📍 Selecciona un punto en el mapa"
            android:textColor="#00FFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConfirmarUbicacionMap"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#00FFFF"
            android:text="Confirmar esta ubicación"
            android:textAllCaps="false"
            android:textColor="#0B0E14"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>