<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- MAPA OPENSTREETMAP COMPLETO -->
    <org.osmdroid.views.MapView
        android:id="@+id/osmMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- BARRA SUPERIOR FLOTANTE -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBarMap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnBackMap"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/input"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvMapHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/vitrina"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="RADAR REGIONAL • CHILLÁN"
            android:textColor="@color/neon_cyan"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btnBackMap"
            app:layout_constraintStart_toEndOf="@id/btnBackMap"
            app:layout_constraintTop_toTopOf="@id/btnBackMap" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- BOTÓN FLOTANTE: CENTRAR EN MI UBICACIÓN -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCenterLocation"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/input"
        android:text="◎"
        android:textColor="@color/neon_cyan"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>