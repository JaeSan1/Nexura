<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="30dp">

            <!-- BANNER DE FONDO Y AVATAR -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- BANNER DE PORTADA -->
                <ImageView
                    android:id="@+id/ivProfileBanner"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:background="#1E293B"
                    android:contentDescription="Banner de Perfil"
                    android:scaleType="centerCrop"
                    android:src="@drawable/categoria"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- BOTÓN ATRÁS -->
                <TextView
                    android:id="@+id/btnBackPerfil"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_margin="16dp"
                    android:background="@drawable/badge"
                    android:gravity="center"
                    android:text="←"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- FOTO DE PERFIL SUPERPUESTA A LA IZQUIERDA -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfileAvatar"
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="114dp"
                    android:background="#1E293B"
                    android:contentDescription="Foto de Perfil"
                    android:padding="3dp"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="#0F172A"
                    app:strokeWidth="4dp" />

                <!-- INFORMACIÓN PRINCIPAL DEL USUARIO -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="168dp"
                    android:layout_marginEnd="20dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivProfileAvatar"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvProfileGamertag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="TheGoat99" />

                        <TextView
                            android:id="@+id/tvVerifiedBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="✔"
                            android:textColor="#00F2FE"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEquippedTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#00F2FE"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="CONQUISTADOR DE FESTIVALES" />

                    <TextView
                        android:id="@+id/tvProfileLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        tools:text="📍 Chillán, Chile" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- BIOGRAFÍA -->
            <TextView
                android:id="@+id/tvProfileBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="3dp"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                tools:text="Organizador independiente de eventos geek y gaming en Chillán. Apasionado por crear experiencias para la comunidad." />

            <!-- BARRA DE NIVEL Y XP -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#1E293B"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvProfileLevel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="#00F2FE"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="NIVEL 27" />

                        <TextView
                            android:id="@+id/tvXpProgressText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            tools:text="1,200 / 2,500 XP" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pbProfileXp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="10dp"
                        android:progressDrawable="@drawable/categoria"
                        tools:progress="60" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ESTADÍSTICAS (SEGUIDORES, SEGUIDOS, LIKES) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/categoria"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFollowersCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="342" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seguidores"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFollowingCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="120" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seguidos"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvReputationLikesCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="1.2K" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reputación"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- BOTÓN EDITAR PERFIL -->
            <Button
                android:id="@+id/btnQuickEdit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#1E293B"
                android:text="Editar Perfil"
                android:textColor="#00F2FE"
                android:textStyle="bold" />

            <!-- SECCIÓN DE EXHIBICIÓN DE LOGROS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LOGROS DESBLOQUEADOS"
                    android:textColor="#00F2FE"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAchievementsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    tools:text="3/6 Logros" />
            </LinearLayout>

            <!-- CONTENEDOR DE TARJETAS DE LOGROS -->
            <LinearLayout
                android:id="@+id/containerLogros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>