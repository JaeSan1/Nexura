<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base de la aplicación en Modo Oscuro -->
    <style name="Theme.Nexura" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color (Oscuro de Nexura) -->
        <item name="android:statusBarColor">#0F172A</item>
    </style>

    <!-- TEMA PARA EL SPLASH SCREEN (NIGHT) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Fondo oscuro de la pantalla de bienvenida -->
        <item name="windowSplashScreenBackground">#0F172A</item>
        <!-- Isotipo neón 'N' vectorial en el centro -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo_nexura</item>
        <!-- Tema al que cambia la app automáticamente al terminar de cargar -->
        <item name="postSplashScreenTheme">@style/Theme.Nexura</item>
    </style>
</resources>