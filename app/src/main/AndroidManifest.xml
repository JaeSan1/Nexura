<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nexura">

        <!-- Entrada Principal -->
        <activity
            android:name=".ui.Login"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantallas Secundarias -->
        <activity android:name=".ui.Registro" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.RecuperarPassword" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.Home" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.Explorar" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.MisEventos" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.Perfil" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.EditarPerfil" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.Detalle_Evento" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.CrearEvento" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.PanelOrganizador" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.Notificaciones" android:exported="false" android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>